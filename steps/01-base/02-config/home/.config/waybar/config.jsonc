{
  "layer": "top",
  "position": "top",
  "margin": "0 64 0 64",
  "fixed-center": true,

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/submap"
  ],
  "modules-center": [
    "clock#date",
    "clock#clock"
  ],
  "modules-right": [
    "custom/updates",
    "pulseaudio#sink",
    "pulseaudio#source",
    "backlight",
    "cpu",
    "memory",
    "custom/network-traffic",
    "tray",
    "battery",
    "idle-inhibitor",
    "custom/power"
   ],

  "hyprland/workspaces": {
    "format": "{icon} {windows}",
    "workspace-taskbar": {
      "enable": true,
      "icon-size": 12
    }
  },
  "hyprland/submap": {
    "tooltip": false
  },
  "idle-inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "on-click":"exec ~/.config/waybar/scripts/idle-inhibitor.sh"
  },
  "tray": {
    "icon-size": 16
  },
  "clock#date": {
    "tooltip-format": "<big>{:%A, %d. %B %Y }</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%A, %d. %b}",
    "interval": 60
  },
  "clock#clock": {
    "tooltip-format": "<big>{:%H:%M:%S}</big>",
    "format": "{:%H:%M}",
    "interval": 1
  },
  "cpu": {
    "format": "🖳{usage}%"
  },
  "memory": {
    "format": "🖴 {: >3}%"
  },
  "backlight": {
    // "device": "acpi_video1",
    "format": "{icon} {percent: >3}%",
    "format-icons": ["", ""],
    "on-scroll-down": "brightnessctl -c backlight set 1%-",
    "on-scroll-up": "brightnessctl -c backlight set +1%"
  },
  "battery": {
    "states": {
      // "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity: >3}%",
    "format-icons": ["", "", "", "", ""]
  },
  "custom/updates": {
    "format": "{} {icon}",
    "return-type": "json",
    "format-icons": {
      "has-updates": "󱍷",
      "updated": "󰂪"
    },
    "exec": "waybar-module-pacman-updates --interval-seconds 5 --network-interval-seconds 7200 --network-interval-seconds",
    "on-click": "kitty paru -Syu --color=auto"
  },
  "custom/power": {
    "format":"⏻",
    "on-click": "wlogout",
    "tooltip": false
  },
  "custom/network-traffic": {
    "exec": "~/.config/waybar/scripts/network-traffic.sh",
    "return-type": "json",
    "format-ethernet": "{icon} {ifname} ⇣{bandwidthDownBytes} ⇡{bandwidthUpBytes}",
    "min-length": 12
  },
  "pulseaudio#sink": {
    "scroll-step": 1, // %, can be a float
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-bluetooth": "{volume}% {icon}",
    "format-bluetooth-muted": " {icon}",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },
  "pulseaudio#source": {
    "scroll-step": 1, // %, can be a float
    "format": "{format_source}",
    "format-source": "",
    "format-source-muted": "",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "pavucontrol"
  }
}
