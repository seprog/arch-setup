background {
  path = screenshot
  blur_size = 2
  blur_passes = 4
  noise = 0
  contrast = 1.2
  vibrancy = 1
}

general {
  hide_cursor = true
}

animations {
  enabled = true
}

{% if monitors %}
{% for monitor, values in monitors %}
input-field {
  monitor = {{ monitor }}
  size = 250, 60
  outline_thickness = 2
  dots_size = 0.2 # Scale of input-field height, 0.2 - 0.8
  dots_spacing = 0.35 # Scale of dots' absolute size, 0.0 - 1.0
  dots_center = true
  inner_color = rgb({{ values.primary[2] }})
  outer_color = rgb({{ values.accents[2][1] }})
  font_color = rgb({{ values.accents[2][6] }})
  fade_on_empty = false
  rounding = -1
  check_color = rgb({{ values.text[2] }})
  placeholder_text = <i><span foreground="##{{ values.accents[2][6] }}">Input Password...</span></i>
  hide_input = false
  position = 0, -200
  halign = center
  valign = center
}

# date
label {
  monitor = {{ monitor }}
  text = cmd[update:1000] echo "$(date +"%A, %B %d")"
  color = rgba({{ values.accents[1][6] }}FB)
  font_size = 22
  font_family = Noto Nerd Font
  position = 0, 300
  halign = center
  valign = center
}

# time
label {
  monitor = {{ monitor }}
  text = cmd[update:1000] echo "$(date +"%R")"
  color = rgba({{ values.accents[0][6] }}FB)
  font_size = 95
  font_family = Noto Nerd Font Extrabold
  position = 0, 200
  halign = center
  valign = center
}
{% endfor %}
{% else %}
input-field {
  size = 250, 60
  outline_thickness = 2
  dots_size = 0.2 # Scale of input-field height, 0.2 - 0.8
  dots_spacing = 0.35 # Scale of dots' absolute size, 0.0 - 1.0
  dots_center = true
  inner_color = rgb({{ primary[2] }})
  outer_color = rgb({{ accents[2][1] }})
  font_color = rgb({{ accents[2][6] }})
  fade_on_empty = false
  rounding = -1
  check_color = rgb({{ text[2] }})
  placeholder_text = <i><span foreground="##{{ accents[2][6] }}">Input Password...</span></i>
  hide_input = false
  position = 0, -200
  halign = center
  valign = center
}

# date
label {
  text = cmd[update:1000] echo "$(date +"%A, %B %d")"
  color = rgba({{ accents[1][6] }}FB)
  font_size = 22
  font_family = Noto Nerd Font
  position = 0, 300
  halign = center
  valign = center
}

# time
label {
  text = cmd[update:1000] echo "$(date +"%R")"
  color = rgba({{ accents[0][6] }}FB)
  font_size = 95
  font_family = Noto Nerd Font Extrabold
  position = 0, 200
  halign = center
  valign = center
}
{% endif %}
