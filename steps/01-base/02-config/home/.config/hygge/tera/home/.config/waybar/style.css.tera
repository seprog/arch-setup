{% if monitors %}
{% for monitor, values in monitors %}
* {
  border: 0;
  border-radius: 0 0 8px 8px;
  padding: 0 8px;
  font-family: Noto Nerd Font;
  font-size: 12px;
  margin-right: 4px;
  margin-left: 4px;
}


window#waybar {
  background: rgba(0,0,0,0);
}


#workspaces * {
  padding: 0 0;
}

.{{ monitor }} #workspaces button {
  color: #{{ values.accents[0][4] }};
  background: {{ values.primary_rgba[0] | replace(from='\1', to='0.65') }};
}

.{{ monitor }} #workspaces button.visible:not(.active) {
  color: #{{ values.accents[1][8] }};
  background: {{ values.primary_rgba[1] | replace(from='\1', to='0.65') }};
}

.{{ monitor }} #workspaces button.active {
  color: #{{ values.accents[2][8] }};
  background: {{ values.primary_rgba[2] | replace(from='\1', to='0.85') }};
}

#workspaces .taskbar-window {
  margin: 0 0;
}


.{{ monitor }} #submap {
  color: #{{ values.accents[1][8] }};
  background: {{ values.primary_rgba[1] | replace(from='\1', to='0.85') }};
}


.{{ monitor }} #clock {
  color: #{{ values.accents[1][8] }};
  background: {{ values.primary_rgba[1] | replace(from='\1', to='0.65') }};
}


.{{ monitor }} #battery, #cpu, #memory, #idle-inhibitor, #backlight, #pulseaudio, #tray, #custom-power, #custom-updates, #custom-network-traffic {
  color: #{{ values.accents[0][8] }};
  background: {{ values.primary_rgba[0] | replace(from='\1', to='0.65') }};
}


#battery.charging {
  color: lime;
}

@keyframes blink {
  to {
    color: red;
  }
}
#battery.critical:not(.charging) {
  animation-name: blink;
  animation-duration: 0.5s;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}


.{{ monitor }} #pulseaudio.sink.muted {
  color: #{{ values.accents[0][4] }};
}

.{{ monitor }} #pulseaudio.source.source-muted {
  color: #{{ values.accents[0][4] }};
}


#custom-updates:not(.updated) {
  color: orange;
}
{% endfor %}
{% endif %}
