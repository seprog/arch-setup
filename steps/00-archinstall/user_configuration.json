{
  "app_config": {
    "audio_config": {
      "audio": "pipewire"
    },
    "bluetooth_config": {
      "enabled": true
    }
  },
  "bootloader": "Systemd-boot",
  "custom_commands": [
    "for user in $(ls /home); do echo 'git clone -b dev https://github.com/seprog/hygge ~/hygge && cd ~/hygge && ./install.sh; cd ~' >> /home/$user/.bash_profile; done"
  ],
  "kernels": [ "linux-zen" ],
  "locale_config": {
    "kb_layout": "de",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US.UTF-8"
  },
  "mirror_config": {
    "optional_repositories": [ "multilib" ]
  },
  "network_config": {
    "type": "iso"
  },
  "ntp": true,
  "packages": [
    "base-devel",
    "git"
  ],
  "parallel_downloads": 15,
  "swap": true,
  "timezone": "Europe/Berlin"
}
